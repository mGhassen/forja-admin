VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Same Turnstile site key as the Forja web portal (hosted Auth captcha).
# VITE_TURNSTILE_SITE_KEY=…
# Or rely on a sibling ../Forja/.env TURNSTILE_SITE_KEY via vite.config bridge.

# Optional OAuth (vendored @forja/auth). Enable providers in Supabase Auth and
# add redirect `https://admin…/auth/callback`.
# VITE_AUTH_OAUTH_PROVIDERS=google

# Server-only — IPTV catalog Inngest scrape (never VITE_*)
# Comma-separated Reddit installed-app client IDs (also set on Vercel).
# REDDIT_CLIENT_IDS=
# SUPABASE_SERVICE_ROLE_KEY=
# Falls back to sibling ../Forja/.env SUPABASE_* via vite.config.
# INNGEST_EVENT_KEY=          # required on Vercel (Inngest → Event keys)
# INNGEST_SIGNING_KEY=        # required on Vercel (Inngest → Signing key)
# INNGEST_SERVE_ORIGIN=https://admin.forjahq.xyz
#   Prod: set on Vercel so Inngest Cloud syncs the custom domain
#   (not protected *.vercel.app). Code defaults to this on Vercel if unset.
# Local only (never set on Vercel):
# INNGEST_DEV=1
#   npx inngest-cli@latest dev -u http://127.0.0.1:4000/api/inngest
#
# Optional — LLM extract is OFF unless IPTV_LLM_EXTRACT=1 (key alone does nothing):
# ANTHROPIC_API_KEY=
# IPTV_LLM_MODEL=claude-haiku-4-5-20251001
# IPTV_LLM_EXTRACT=1
# Agent: src/server/iptv-catalog/agent/ (opt-in only; errors never fail scrape)

# Server-only — PostHog persons on Accounts (never VITE_*).
# Personal API key with person:read (+ query:read).
# POSTHOG_PROJECT_ID = numeric id *or* full project API token (phc_…).
# Do not strip phc_ — that suffix is not the project id. Server uses ?token=phc_….
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://us.i.posthog.com
#   EU: https://eu.i.posthog.com

# Server-only — Downloads stats + Inngest R2 rollup (never VITE_*).
# Same keys as sibling Forja/.env / GitHub release secrets. Also set on Vercel.
# R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=forja-releases
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_API_TOKEN=   # Account Analytics Read (cron GraphQL → stats/downloads.json)
# RELEASE_CDN_URL=https://cdn.forjahq.xyz
